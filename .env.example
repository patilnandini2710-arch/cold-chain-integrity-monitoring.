# ========================================================
# Cold Chain Integrity Monitor - Environment Configuration
# ========================================================
# Copy this file to '.env' and fill in your Firebase credentials.
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client.

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Realtime Database Path (Default: coldchain/latest)
VITE_FIREBASE_DB_PATH=coldchain/latest

# Optional Custom Field Mappings (for future hardware configurations)
VITE_FIELD_TEMP=temperature
VITE_FIELD_HUMIDITY=humidity
VITE_FIELD_DISTANCE=distance
VITE_FIELD_LID=lid
VITE_FIELD_LID_OPEN=lidOpen
VITE_FIELD_TIMESTAMP=timestamp
